# Public in the JS bundle. In the Unsplash dashboard, restrict this key to
# https://ultrapilled.com/* (and http://localhost:5173/* for local dev).
VITE_UNSPLASH_ACCESS_KEY=
# Public in the JS bundle. Restrict this key to this origin in the Giphy dashboard.
VITE_GIPHY_API_KEY=
# Shared Orby/Resend inbox. Leave empty in local dev — Vite proxies /api/bug-report.
# Production default: https://orby-gamma.vercel.app/api/bug-report
VITE_BUG_REPORT_API_URL=
# Isso guestbook (guestbook/). Leave empty: dev uses http://localhost:8080, prod https://guestbook.ultrapilled.com.
VITE_GUESTBOOK_API_URL=
# Public Turnstile site key. Add ultrapilled.com (and localhost) on the Cloudflare widget.
# Same secret as Orby lives on the shared Vercel API (TURNSTILE_SECRET_KEY).
VITE_TURNSTILE_SITE_KEY=
